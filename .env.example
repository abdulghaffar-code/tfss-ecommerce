# PostgreSQL connection string.
# Local project cluster: npm run db:start then use this URL.
# Production: replace with your managed PostgreSQL URL, e.g.
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres@127.0.0.1:55432/tfss?schema=public"

# Canonical public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Only used by `npm run db:seed`. Use a strong password in production.
SEED_ADMIN_EMAIL="admin@totalfirensafety.com"
SEED_ADMIN_PASSWORD="change-this-before-production"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="change-this-before-production"
